<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Conquer</AssemblyName>
    <!-- No ICU dependency, so it runs on minimal Linux systems; Program.cs sets the Spanish number format. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Conquer.Client</RootNamespace>
    <Version>1.126.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Conquer.Game\Conquer.Game.csproj" />
    <ProjectReference Include="..\Conquer.Presentation\Conquer.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.GLFW" Version="2.23.0" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="StbTrueTypeSharp" Version="1.26.13" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Lato-Light.ttf" LogicalName="Conquer.Client.Assets.Lato-Light.ttf" />
    <EmbeddedResource Include="Assets\Lato-Regular.ttf" LogicalName="Conquer.Client.Assets.Lato-Regular.ttf" />
    <EmbeddedResource Include="Assets\Cinzel-Regular.ttf" LogicalName="Conquer.Client.Assets.Cinzel-Regular.ttf" />
    <EmbeddedResource Include="Assets\Audio\Music\*.ogg" LogicalName="Audio/Music/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Audio\Sfx\*.ogg" LogicalName="Audio/Sfx/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Sprites\*.png" LogicalName="Sprites/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Sprites\Units\*.png" LogicalName="Sprites/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Portraits\*.png;Assets\Portraits\*.jpg" LogicalName="Portraits/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\BuildingIcons\*.png;Assets\BuildingIcons\*.jpg" LogicalName="BuildingIcons/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\ResourceIcons\*.png;Assets\ResourceIcons\*.jpg" LogicalName="ResourceIcons/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
