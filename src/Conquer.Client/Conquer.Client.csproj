<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Conquer</AssemblyName>
    <!-- No ICU dependency, so it runs on minimal Linux systems; Program.cs sets the Spanish number format. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Conquer.Client</RootNamespace>
    <!-- Game version: bump on every change and add a matching entry at the top of CHANGELOG.md. -->
    <Version>1.32.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Conquer.Game\Conquer.Game.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.GLFW" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="StbTrueTypeSharp" Version="1.26.13" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\FiraSans-Regular.ttf" LogicalName="Conquer.Client.Assets.FiraSans-Regular.ttf" />
    <EmbeddedResource Include="Assets\FiraSans-Bold.ttf" LogicalName="Conquer.Client.Assets.FiraSans-Bold.ttf" />
    <EmbeddedResource Include="Assets\Cinzel.ttf" LogicalName="Conquer.Client.Assets.Cinzel.ttf" />
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="CHANGELOG.md" />
    <InternalsVisibleTo Include="Conquer.Tests" />
  </ItemGroup>

</Project>
